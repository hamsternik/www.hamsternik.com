# claude-code local conf settings
.claude/settings.local.json

node_modules/
dist/
*.tsbuildinfo
.DS_Store
.vercel
*.log
package-lock.json
.eslintcache

# ignore top-level vscode settings
/.vscode/settings.json

# do not commit .env files or any files that end with `.env`
*.env

## Astro auto-generated cache and content-collection types
.astro/

# exclude IntelliJ/WebStorm stuff
.idea

# TeX.gitignore
# https://github.com/github/gitignore/blob/main/TeX.gitignore

cv/build

# an auto-generated file by Emacs AUCTeX.
# eMacs creates _region_.tex as a temp file containing:
# doc preamble, e.g. package, macros; selected text region, etc.
# the file recreates each time when you are using region compilation.
_region_.tex

# the /auto dir is auto generated direction, containing style hooks,
# to cache information about LaTeX document for faster parsin and better auto-completion.
cv/auto/

