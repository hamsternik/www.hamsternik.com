---
import { Image } from 'astro:assets';
import HeaderLink from './HeaderLink.astro';
import avatar from '../assets/avatar.png';
---

<!-- Off-screen until focused: not `hidden`, which would make it unfocusable. -->
<a
	class="absolute left-[-9999px] top-0 z-10 rounded-br border border-current bg-page px-4 py-2 text-accent focus:left-0"
	href="#main">Skip to content</a
>
<header class="px-4 pt-8">
	<a class="avatar-link" href="/about">
		<Image
			class="avatar"
			src={avatar}
			width={112}
			height={112}
			densities={[2]}
			alt="About Niki Khomitsevych"
		/>
	</a>
	<nav class="flex flex-wrap justify-center gap-x-6 gap-y-1">
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
	</nav>
</header>

<style>
	/* The link, not the image, carries the centering: an inline <a> would
	   collapse to its content and margin:auto on the image would not center. */
	.avatar-link {
		display: block;
		width: 112px;
		margin: 0 auto 1em;
	}
	.avatar {
		display: block;
		width: 112px;
		height: 112px;
		border-radius: 50%;
		/* A box-shadow ring rather than a border: it grows outward without
		   changing the element's box, so nothing around it shifts. */
		box-shadow: 0 0 0 0 var(--avatar-ring);
		transition: box-shadow 0.125s ease-out;
	}
	.avatar-link:hover .avatar,
	.avatar-link:focus-visible .avatar {
		box-shadow: 0 0 0 5px var(--avatar-ring);
	}

	/* Ring is Obsidian Grey in light mode — the same token the dark theme uses
	   as its surface. It has to invert in dark mode, since an obsidian ring on
	   an obsidian background would be invisible. */
	.avatar-link {
		--avatar-ring: rgba(var(--obsidian), 0.25);
	}
	@media (prefers-color-scheme: dark) {
		.avatar-link {
			--avatar-ring: rgba(var(--gray-dark), 0.35);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.avatar {
			transition: none;
		}
	}
</style>
