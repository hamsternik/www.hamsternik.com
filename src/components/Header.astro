---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 2em 1em 0;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		column-gap: 1.5em;
		row-gap: 0.25em;
	}
	nav :global(a) {
		color: rgb(var(--gray-dark));
	}
	nav :global(a:hover),
	nav :global(a.active) {
		color: var(--accent);
	}
</style>
