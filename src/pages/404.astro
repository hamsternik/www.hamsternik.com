---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="404 — Not found"
			description="This page does not exist, or it moved somewhere else."
		/>
	</head>
	<body>
		<Header />
		<main id="main">
			<div class="notfound">
				<h1>404</h1>
				<p>This page does not exist, or it moved somewhere else.</p>
				<nav class="goto">
					Go to <a href="/">home</a>, <a href="/about">about</a> or
					<a href="/blog">blog</a>.
				</nav>
				<div class="dinkus">✦</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.notfound {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		min-height: 60vh;
	}
	.notfound h1 {
		font-size: 6rem;
		margin: 0;
		color: rgb(var(--gray));
		line-height: 1;
	}
	.notfound p {
		margin: 0.5rem 0 1.5rem;
		color: rgb(var(--gray));
	}
	.goto {
		color: rgb(var(--gray));
	}
	.dinkus {
		margin-top: 3rem;
		color: rgb(var(--gray-light));
	}
	@media (max-width: 480px) {
		.notfound h1 {
			font-size: 4rem;
		}
	}
</style>
